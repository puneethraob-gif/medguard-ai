# Copy to backend/.env for local backend-only development. All secrets stay blank.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:19006
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PATIENT_DATA_ENCRYPTION_KEY=
SECURE_COOKIES=false
CONSULTATION_AUDIO_ENCRYPTION_KEY=
CONSULTATION_AUDIO_DIR=./var/consultation-audio
CONSULTATION_MAX_AUDIO_BYTES=52428800
CONSULTATION_AUDIO_RETENTION_DAYS=30
STT_PROVIDER=disabled
SARVAM_API_KEY=
# Legacy alias retained for existing deployments; prefer SARVAM_API_KEY.
STT_API_KEY=
STT_BASE_URL=https://api.sarvam.ai
STT_MODEL=saaras:v4
STT_MODE=codemix
STT_KEYTERMS=
STT_REQUEST_TIMEOUT_SECONDS=45
STT_BATCH_TIMEOUT_SECONDS=7200
STT_MAX_SPEAKERS=2
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=sarvam-105b
LLM_REQUEST_TIMEOUT_SECONDS=60
