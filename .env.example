# Copy to .env and change values for local development.
POSTGRES_DB=healthcare_companion
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:19006
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
JWT_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

PATIENT_DATA_ENCRYPTION_KEY=

SECURE_COOKIES=false

# Keep these keys in a secrets manager outside local development. Never commit generated values.
CONSULTATION_AUDIO_ENCRYPTION_KEY=
CONSULTATION_AUDIO_DIR=./var/consultation-audio
CONSULTATION_MAX_AUDIO_BYTES=52428800
CONSULTATION_AUDIO_RETENTION_DAYS=30
STT_PROVIDER=disabled
# Preferred Sarvam key name. Existing STT_API_KEY remains supported for compatibility.
SARVAM_API_KEY=
STT_API_KEY=
STT_BASE_URL=https://api.sarvam.ai
STT_MODEL=saaras:v4
STT_MODE=codemix
STT_KEYTERMS=
STT_REQUEST_TIMEOUT_SECONDS=45
STT_BATCH_TIMEOUT_SECONDS=7200
STT_MAX_SPEAKERS=2
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=sarvam-105b
LLM_REQUEST_TIMEOUT_SECONDS=60
