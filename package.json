{
  "name": "healthcare-companion-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:web": "npm --prefix apps/doctor-dashboard install",
    "install:mobile": "npm --prefix apps/patient-mobile install",
    "install:all": "npm run install:web && npm run install:mobile",
    "dev:web": "npm --prefix apps/doctor-dashboard run dev",
    "dev:mobile": "npm --prefix apps/patient-mobile run start",
    "build:web": "npm --prefix apps/doctor-dashboard run build",
    "test:web": "npm --prefix apps/doctor-dashboard run test",
    "test:mobile": "npm --prefix apps/patient-mobile run test"
  }
}
